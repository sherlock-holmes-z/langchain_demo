# DeepSeek API 密钥。复制本文件为 .env 后填写真实值，禁止提交真实密钥。
DEEPSEEK_API_KEY=
# ChatDeepSeek 会自动读取该变量；不要写成 DEEPSEEK_BASE_URL。
DEEPSEEK_API_BASE=https://api.deepseek.com


# LangSmith
# 是否开启监控
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# 监控webUI地址，非美区需要指定
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 自定义项目名称
LANGSMITH_PROJECT=langchain-demo
